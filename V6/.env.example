# V6 配置模板
#
# 使用方式：
# 1. 复制本文件为 .env：
#      cp .env.example .env
# 2. 按实际环境填写 token、飞书应用凭证、LLM 配置。
# 3. batch_run_v6.py / tiktok_age_workflow_v6.py / gui_app.py 会自动读取 V6/.env。
#
# 注意：
# - 不要提交真实 .env，里面通常包含飞书 app_secret、模型 AK/API key。
# - 每个 agent 都会输入完整截图与元信息；差异主要来自不同 LLM 产品或模型。
# - per-agent 配置优先级高于 shared fallback 配置。


# ----------------------------
# 飞书表格配置
# ----------------------------
# 批量任务读取和写回的 spreadsheet token。
# 如果启动命令显式传 --token，则命令行参数优先。
# 例：飞书表格 URL https://.../sheets/xxxxxx 中的 xxxxxx。
BATCH_SPREADSHEET_TOKEN=

# 输入 sheet 名。要求至少有 profile_link 或 URL 列，存放 TikTok profile 链接。
BATCH_SHEET1=Sheet1

# 输出 sheet 名。V6 会自动新增/写回以下列：
# [Agent-Labeling]age
# [Agent-Labeling]final_result
# [Agent-Labeling]confidence
# [Agent-Labeling]consensus_level
# [Agent-Labeling]accepted_gt
# [Agent-Labeling]reject_reason
# [Agent-Labeling]agent_votes
# [Agent-Labeling]error
# [Agent-Labeling]agent_a_age / agent_a_gender / agent_a_confidence
# [Agent-Labeling]agent_b_age / agent_b_gender / agent_b_confidence
# [Agent-Labeling]agent_c_age / agent_c_gender / agent_c_confidence
# （agent 列名根据 AGENT_CONFIGS 动态生成）
BATCH_SHEET2=Sheet2

# 兼容 recover_v6.py 默认参数；通常填同一个 token。
OUTPUT_SPREADSHEET_TOKEN=
OUTPUT_SHEET_NAME=Sheet2


# ----------------------------
# 飞书表格行数上限（全局单一配置）
# ----------------------------
# 所有链路（读输入表、读输出表去重、写回定位空行、清空）共用这一个上限。
# 之前多处硬编码 20000 导致只能读到 2 万行；改这里即可统一放开。
# 缺省 200000。想读更多就调大。
MAX_SHEET_ROWS=200000


# ----------------------------
# 飞书开放平台应用凭证
# ----------------------------
# 用于读取/写入飞书 Sheets。
# 需要确保该应用有表格读写权限，并且表格已授权给该应用。
FEISHU_APP_ID=
FEISHU_APP_SECRET=


# ----------------------------
# Shared fallback LLM 配置
# ----------------------------
# 当某个 agent 没有单独配置 provider/model/key 时，会回退使用这里的配置。
#
# LLM_PROVIDER 可选：
# - 留空 / modelhub_v2：走 ModelHub v2 接口（默认）
# - openai / ark：走 OpenAI/ARK 兼容接口
LLM_PROVIDER=

# OpenAI / 火山方舟 / Doubao 兼容接口配置。
# provider=openai 或 provider=ark 时使用。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# ModelHub v2 配置。
# LLM_PROVIDER=modelhub_v2 时使用。
MODELHUB_V2_AK=
MODELHUB_V2_BASE_URL=https://aidp.bytedance.net
MODELHUB_V2_API_PATH=/api/modelhub/online/v2/crawl
MODELHUB_V2_MODEL=Doubao-1.5-thinking-vision-pro-250428


# ----------------------------
# 多 agent 总体配置
# ----------------------------
# agent 名称列表。名称会被转换成环境变量前缀：
# agent_a -> AGENT_A_*
# agent_b -> AGENT_B_*
# agent_c -> AGENT_C_*
AGENT_CONFIGS=agent_a,agent_b,agent_c

# 每个 case 最多并行调用多少个 agent。
# 通常保持 3；如果只想临时跑单 agent 调试，可设为 1 并调整 AGENT_CONFIGS。
NUM_AGENTS=3

# 单个 agent 的 LLM 调用读超时秒数。
AGENT_TIMEOUT_SECONDS=90


# ----------------------------
# Agent A 配置：标准判断
# ----------------------------
# PROVIDER 可选：
# - 留空：使用 shared fallback 的 LLM_PROVIDER（默认走 ModelHub）
# - modelhub_v2：该 agent 使用 ModelHub v2
# - openai / ark：该 agent 使用 OpenAI/ARK 兼容接口
AGENT_A_PROVIDER=

# OpenAI/ARK 兼容接口模型名。留空则回退到 ARK_MODEL / OPENAI_MODEL。
AGENT_A_MODEL=

# OpenAI/ARK 兼容接口 base URL。留空则回退到 ARK_BASE_URL / OPENAI_BASE_URL。
AGENT_A_BASE_URL=

# OpenAI/ARK 兼容接口 API key。留空则回退到 ARK_API_KEY / OPENAI_API_KEY。
AGENT_A_API_KEY=

# ModelHub v2 AK。AGENT_A_PROVIDER=modelhub_v2 时优先使用。
AGENT_A_MODELHUB_V2_AK=

# ModelHub v2 base URL / api_path / model。留空则回退到 shared fallback。
AGENT_A_MODELHUB_V2_BASE_URL=
AGENT_A_MODELHUB_V2_API_PATH=
AGENT_A_MODELHUB_V2_MODEL=

# prompt 轻量校准，可选：
# - standard：标准 GT 筛选 prompt
# - age_underestimation_guard：加强年龄低估校准
# - confidence_conservative：加强 high confidence 保守性
AGENT_A_CALIBRATION=standard


# ----------------------------
# Agent B 配置：年龄低估校准
# ----------------------------
AGENT_B_PROVIDER=
AGENT_B_MODEL=
AGENT_B_BASE_URL=
AGENT_B_API_KEY=
AGENT_B_MODELHUB_V2_AK=
AGENT_B_MODELHUB_V2_BASE_URL=
AGENT_B_MODELHUB_V2_API_PATH=
AGENT_B_MODELHUB_V2_MODEL=
AGENT_B_CALIBRATION=age_underestimation_guard


# ----------------------------
# Agent C 配置：置信度保守校准
# ----------------------------
AGENT_C_PROVIDER=
AGENT_C_MODEL=
AGENT_C_BASE_URL=
AGENT_C_API_KEY=
AGENT_C_MODELHUB_V2_AK=
AGENT_C_MODELHUB_V2_BASE_URL=
AGENT_C_MODELHUB_V2_API_PATH=
AGENT_C_MODELHUB_V2_MODEL=
AGENT_C_CALIBRATION=confidence_conservative


# ----------------------------
# 常见配置示例
# ----------------------------
# 示例 1：三个 agent 共用同一个 ARK 兼容接口，只用不同校准 prompt。
# LLM_PROVIDER=
# ARK_API_KEY=xxx
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-seed-2-0-pro-260215
#
# 示例 2：Agent A/B/C 使用不同模型。
# AGENT_A_MODEL=model_a
# AGENT_B_MODEL=model_b
# AGENT_C_MODEL=model_c
#
# 示例 3：Agent A 使用 ModelHub v2，B/C 使用 ARK 兼容接口。
# AGENT_A_PROVIDER=modelhub_v2
# AGENT_A_MODELHUB_V2_AK=xxx
# AGENT_A_MODELHUB_V2_MODEL=Doubao-1.5-thinking-vision-pro-250428
# AGENT_B_PROVIDER=
# AGENT_B_API_KEY=xxx
# AGENT_B_MODEL=model_b
# AGENT_C_PROVIDER=
# AGENT_C_API_KEY=xxx
# AGENT_C_MODEL=model_c
#
# 示例 4：Agent A/B 使用不同的 ModelHub API 路径（推荐配置）。
# AGENT_A_PROVIDER=modelhub_v2
# AGENT_A_MODELHUB_V2_AK=xxx
# AGENT_A_MODELHUB_V2_API_PATH=/api/modelhub/online/v2/crawl
# AGENT_A_MODELHUB_V2_MODEL=Doubao-1.5-thinking-vision-pro-250428
# AGENT_B_PROVIDER=modelhub_v2
# AGENT_B_MODELHUB_V2_AK=yyy
# AGENT_B_MODELHUB_V2_API_PATH=/api/modelhub/online/multimodal/crawl
# AGENT_B_MODELHUB_V2_MODEL=gemini-2.5-flash
